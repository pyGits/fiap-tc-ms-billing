# Billing Service — participante da Saga (orçamento e pagamento)
PORT=3001
NODE_ENV=development
SERVICE_NAME=fiap-tc-ms-billing
LOG_LEVEL=debug

# Banco próprio (MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fiap_tc_billing
MONGO_TIMEOUT_MS=5000

# Mensageria
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10

# Mercado Pago: sem token (ou com MERCADO_PAGO_MOCK=true) usa o provedor em
# memória, que não contata o provedor real.
MERCADO_PAGO_MOCK=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_LIMITE_FALHAS=3
MERCADO_PAGO_WEBHOOK_SECRET=

# Autenticação: true sobe sem Cognito (apenas desenvolvimento e testes)
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Observabilidade
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=fiap-tc-ms-billing-local
